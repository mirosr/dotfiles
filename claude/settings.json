{
  "model": "opus[1m]",
  "tui": "fullscreen",
  "theme": "dark",
  "skipAutoPermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "jq -r 'def seg($l;$v;$y;$r): if $v>=$y then $l else (if $v>=$r then \"\\u001b[33m\" else \"\\u001b[31m\" end)+$l+\"\\u001b[0m\" end; .context_window.remaining_percentage as $ctx | .rate_limits.five_hour.used_percentage as $fu | .rate_limits.seven_day.used_percentage as $wu | [(if $ctx != null then seg(\"context: \\($ctx|round)%\";$ctx;31;11) else empty end), (if $fu != null then (100-$fu) as $f | seg(\"5h: \\($f|round)%\";$f;31;11) else empty end), (if $wu != null then (100-$wu) as $w | seg(\"week: \\($w|round)%\";$w;31;11) else empty end)] | join(\" · \") | if . == \"\" then \"\" else \"◴ \" + . end'"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(access monolith ro)",
      "Bash(agent-browser:*)",
      "Bash(awk:*)",
      "Bash(bash:*)",
      "Bash(bin/rails:*)",
      "Bash(bin/rspec:*)",
      "Bash(brew info *)",
      "Bash(bundle exec:*)",
      "Bash(bundle info *)",
      "Bash(bundle show *)",
      "Bash(cat:*)",
      "Bash(claude doctor *)",
      "Bash(claude:*)",
      "Bash(command:*)",
      "Bash(curl:*)",
      "Bash(echo:*)",
      "Bash(env:*)",
      "Bash(fd:*)",
      "Bash(find:*)",
      "Bash(gem which *)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(jq:*)",
      "Bash(kubectl:*)",
      "Bash(ls:*)",
      "Bash(lsof:*)",
      "Bash(mkdir:*)",
      "Bash(npm run *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Bash(open:*)",
      "Bash(pdfimages:*)",
      "Bash(pdfinfo:*)",
      "Bash(pdftotext:*)",
      "Bash(ps:*)",
      "Bash(python3:*)",
      "Bash(ruby:*)",
      "Bash(scutil --nc start *)",
      "Bash(scutil --nc status *)",
      "Bash(scutil --nc stop *)",
      "Bash(sed:*)",
      "Bash(sh:*)",
      "Bash(sips:*)",
      "Bash(tee:*)",
      "Bash(xargs:*)",
      "Edit(~/work/**)",
      "Read(//private/tmp/**)",
      "Read(//tmp/**)",
      "Read(~/.claude/**)",
      "Read(~/.config/dotfiles/**)",
      "Read(~/.honeybadger-mcp-server.yaml)",
      "Read(~/work/**)",
      "Skill(agent-browser)",
      "Skill(monolith-console)",
      "Skill(pod-logs)",
      "Skill(update-config)",
      "WebFetch",
      "WebSearch",
      "mcp__honeybadger__get_fault",
      "mcp__honeybadger__list_fault_affected_users",
      "mcp__honeybadger__list_fault_notices",
      "mcp__honeybadger__list_faults",
      "mcp__honeybadger__list_projects"
    ]
  }
}
